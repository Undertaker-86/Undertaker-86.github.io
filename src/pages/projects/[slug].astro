---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import VideoLoop from '~/components/VideoLoop.astro';
import Metrics from '~/components/Metrics.astro';
import CadViewer from '~/components/CadViewer.astro';
import { getProjects, dateRange, type Project } from '~/lib/projects';
import { categorySlug } from '~/content.config';

export const getStaticPaths = (async () => {
  const all = await getProjects();
  return all.map((p, i) => ({
    params: { slug: p.id },
    props: { p, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  p: Project;
  prev: Project;
  next: Project;
}
const { p, prev, next } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg', quality: 78 });
const glance: [string, string][] = [
  ['Role', d.role],
  ['Team', d.team],
  ['Context', `${d.context}, ${d.org}`],
  ['Dates', dateRange(p)],
];
---

<Base title={d.short} description={d.summary} image={og.src} active="projects">
  <article>
    <header class="wrap pt-10 sm:pt-14">
      <nav aria-label="Breadcrumb" class="eyebrow mb-6"><a href="/projects" class="hover:text-ink">Projects</a> <span aria-hidden="true">/</span> {d.short}</nav>
      <div class="max-w-4xl">
        {
          d.award && (
            <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-accent px-3 py-1.5 font-mono text-xs font-semibold text-on-accent">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7z" /></svg>
              {d.award}
            </p>
          )
        }
        <ul class="mb-4 flex flex-wrap gap-2">
          {d.categories.map((c) => <li><a class="chip hover:border-ink-3 hover:text-ink" href={`/projects?area=${categorySlug(c)}`}>{c}</a></li>)}
        </ul>
        <h1 class="text-[2rem] leading-[1.08] font-semibold text-ink sm:text-5xl">{d.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-2 sm:text-xl">{d.summary}</p>
      </div>
    </header>

    <div class="wrap mt-8">
      {d.model && (
        <div transition:name={`media-${p.id}`}>
          <CadViewer hero src={d.model.src} poster={d.cover} alt={d.coverAlt} sizeLabel={d.model.size} caption="Drag to rotate, scroll or pinch to zoom." />
        </div>
      )}
      <div class:list={['overflow-hidden rounded-2xl border border-line bg-sunk', d.model && 'hidden']} data-hover-host transition:name={d.model ? undefined : `media-${p.id}`}>
        {
          d.model ? null : d.video ? (
            <div class="aspect-video">
              <VideoLoop slug={p.id} name={d.video} poster={d.cover} alt={d.coverAlt} autoplay posterWidth={1400} sizes="(min-width: 1216px) 1152px, 100vw" fit="contain" eager />
            </div>
          ) : (
            <Picture
              src={d.cover}
              alt={d.coverAlt}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600].filter((w) => w <= d.cover.width)}
              sizes="(min-width: 1216px) 1152px, 100vw"
              quality={72}
              loading="eager"
              fetchpriority="high"
              class="max-h-[70vh] w-full object-contain"
            />
          )
        }
      </div>
    </div>

    <div class="wrap mt-10 grid gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14">
      <aside class="lg:sticky lg:top-20 lg:self-start" aria-label="At a glance">
        <h2 class="eyebrow mb-4">At a glance</h2>
        <dl class="space-y-4 text-sm">
          {
            glance.map(([k, v]) => (
              <div>
                <dt class="font-mono text-[0.68rem] tracking-wider text-ink-3 uppercase">{k}</dt>
                <dd class="mt-0.5 leading-snug text-ink">{v}</dd>
              </div>
            ))
          }
          <div>
            <dt class="font-mono text-[0.68rem] tracking-wider text-ink-3 uppercase">Stack</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1.5">{d.stack.map((s) => <span class="chip">{s}</span>)}</dd>
          </div>
        </dl>
        {
          (d.links.length > 0 || d.codeNote) && (
            <div class="mt-6 border-t border-line pt-5">
              <h2 class="eyebrow mb-3">Links</h2>
              <ul class="space-y-2 text-sm">
                {d.links.map((l) => (
                  <li>
                    <a href={l.href} class="link" rel={l.href.startsWith('/') ? undefined : 'noopener'}>{l.label} {l.href.startsWith('/') ? '→' : '↗'}</a>
                  </li>
                ))}
              </ul>
              {d.codeNote && <p class="mt-3 text-xs leading-relaxed text-ink-3">{d.codeNote}</p>}
            </div>
          )
        }
      </aside>

      <div class="min-w-0">
        <h2 class="sr-only">Key results</h2>
        <Metrics metrics={d.metrics} />
        {
          d.links.filter((l) => l.href.startsWith('/')).map((l) => (
            <a href={l.href} class="card group mt-4 flex items-center justify-between gap-4 p-4 transition-colors hover:border-accent sm:p-5">
              <span>
                <span class="eyebrow">Deep dive</span>
                <span class="mt-0.5 block font-medium text-ink group-hover:text-accent-ink">{l.label}</span>
              </span>
              <span class="text-xl text-accent-ink transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          ))
        }
        <div class="prose mt-4 max-w-[46rem]">
          <Content />
        </div>
        {d.credits && <p class="mt-10 max-w-[46rem] border-l-2 border-line-strong pl-4 text-sm text-ink-3"><span class="font-medium text-ink-2">Credits.</span> {d.credits}</p>}
      </div>
    </div>

    <nav class="wrap mt-16 grid gap-3 sm:grid-cols-2" aria-label="More projects">
      <a href={`/projects/${prev.id}`} class="card group p-5 transition-colors hover:border-line-strong">
        <span class="eyebrow">← Previous</span>
        <span class="mt-1 block font-medium text-ink group-hover:text-accent-ink">{prev.data.title}</span>
      </a>
      <a href={`/projects/${next.id}`} class="card group p-5 text-right transition-colors hover:border-line-strong">
        <span class="eyebrow">Next →</span>
        <span class="mt-1 block font-medium text-ink group-hover:text-accent-ink">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>
