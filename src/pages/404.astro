---
import Base from '~/layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap py-28 text-center">
    <p class="font-mono text-sm text-accent-ink">404 · localization failed</p>
    <h1 class="mt-3 text-4xl font-semibold text-ink">This pose is not on the map.</h1>
    <p class="mt-3 text-ink-2">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-on-accent">Back home</a>
  </section>
</Base>
