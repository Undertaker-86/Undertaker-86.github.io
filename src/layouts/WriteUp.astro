---
/** Layout for long technical write-ups (MDX pages). Frontmatter: title, description, back, backLabel, eyebrow, updated. */
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, description, back, backLabel, eyebrow, updated } = frontmatter;
---

<Base title={title} description={description} active="projects">
  <article class="wrap pt-10 sm:pt-14">
    <nav aria-label="Breadcrumb" class="eyebrow mb-6">
      <a href="/projects" class="hover:text-ink">Projects</a> <span aria-hidden="true">/</span>
      <a href={back} class="hover:text-ink">{backLabel}</a> <span aria-hidden="true">/</span> Technical write-up
    </nav>
    <header class="max-w-3xl">
      <p class="eyebrow text-accent-ink">{eyebrow}</p>
      <h1 class="mt-2 text-[2rem] leading-[1.08] font-semibold text-ink sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-2">{description}</p>
      {updated && <p class="mt-3 font-mono text-xs text-ink-3">Last updated {updated}</p>}
    </header>
    <div class="prose writeup mt-10 max-w-[48rem]">
      <slot />
    </div>
    <a href={back} class="card group mt-14 flex max-w-[48rem] items-center justify-between gap-4 p-5 hover:border-line-strong">
      <span><span class="eyebrow">← Back</span><span class="mt-0.5 block font-medium text-ink group-hover:text-accent-ink">{backLabel} case study</span></span>
    </a>
  </article>
</Base>

<style is:global>
  .writeup table td:first-child {
    color: var(--ink);
  }
  .writeup h2 {
    scroll-margin-top: 5rem;
  }
</style>
