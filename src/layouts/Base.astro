---
import '~/styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import { site } from '~/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  active?: 'home' | 'projects' | 'about';
}
const { title, description = site.description, image, active } = Astro.props;
const fullTitle = title ? `${title} · ${site.shortName}` : `${site.name} · Robotics engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/projects', label: 'Projects', key: 'projects' },
  { href: '/about', label: 'About', key: 'about' },
] as const;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0c0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var q = /[?&]theme=(light|dark)/.exec(location.search); // shareable / QA override
        if (q) t = q[1];
        d.dataset.theme = t === 'light' ? 'light' : 'dark';
        document.addEventListener('astro:after-swap', function () {
          var t2 = null;
          try { t2 = localStorage.getItem('theme'); } catch (e) {}
          document.documentElement.dataset.theme = t2 === 'light' ? 'light' : 'dark';
          document.documentElement.classList.add('js');
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-on-accent">Skip to content</a>
    <header class="no-print sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
      <div class="wrap flex h-14 items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-2.5 font-semibold tracking-tight text-ink">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
            <rect x="1" y="1" width="30" height="30" rx="8" fill="none" stroke="var(--line-strong)" stroke-width="2"></rect>
            <path d="M8 21 C12 9, 18 25, 24 11" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"></path>
            <circle cx="24" cy="11" r="2.6" fill="var(--accent)"></circle>
          </svg>
          <span class="hidden text-[0.95rem] min-[380px]:inline">Gyan&nbsp;Zesiro</span><span class="sr-only min-[380px]:hidden">Gyan Zesiro, home</span>
        </a>
        <nav aria-label="Main" class="flex items-center gap-1 text-sm">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'rounded-md px-2 py-1.5 transition-colors hover:text-ink sm:px-2.5',
                  active === n.key ? 'text-ink' : 'text-ink-2',
                ]}
                aria-current={active === n.key ? 'page' : undefined}
              >
                {n.label}
              </a>
            ))
          }
          <button
            type="button"
            data-theme-toggle
            class="ml-1 grid size-8 place-items-center rounded-md border border-line text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
            aria-label="Toggle light/dark theme"
          >
            <svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="no-print mt-24 border-t border-line">
      <div class="wrap flex flex-col gap-3 py-10 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-mono text-xs">{site.location}</p>
      </div>
    </footer>
    <script>
      import '~/scripts/site.ts';
    </script>
  </body>
</html>

<style is:global>
  [data-theme='dark'] .theme-sun,
  [data-theme='light'] .theme-moon {
    display: none;
  }
</style>
