---
/** A long clip with native controls. Nothing but the poster loads until the viewer presses play. */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: string; // path under /public
  poster: ImageMetadata;
  title: string;
  caption?: string;
  basis?: string;
  size?: string; // e.g. "9.8 MB, 7 min"
}
const { src, poster, title, caption, basis, size } = Astro.props;
const p = await getImage({ src: poster, width: 1280, format: 'webp', quality: 70 });
---

<figure class="reveal my-8">
  <details class="group card overflow-hidden">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 sm:p-5">
      <span class="flex items-center gap-3">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-on-accent" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 1 L11 6 L2 11Z" fill="currentColor"></path></svg>
        </span>
        <span>
          <span class="block font-medium text-ink">{title}</span>
          {size && <span class="font-mono text-xs text-ink-3">{size}, loads only when opened</span>}
        </span>
      </span>
      <span class="font-mono text-xs text-ink-3 group-open:hidden">open</span>
      <span class="hidden font-mono text-xs text-ink-3 group-open:inline">close</span>
    </summary>
    <video class="block w-full bg-black" controls muted playsinline preload="none" poster={p.src} width="1280" height="720">
      <source src={src} type="video/mp4" />
    </video>
  </details>
  {
    (caption || basis) && (
      <figcaption class="mt-2.5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-ink-3">
        {basis && <span class="chip !py-0 !text-[0.65rem] uppercase">{basis}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>
