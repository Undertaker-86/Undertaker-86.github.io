---
/** Figure for case studies: image (zoomable, responsive AVIF/WebP) or looping video, with caption + basis tag. */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import VideoLoop from './VideoLoop.astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  video?: { slug: string; name: string; poster: ImageMetadata };
  caption?: string;
  basis?: string;
  wide?: boolean;
  light?: boolean; // figure was drawn on white: keep a white mat in dark mode
  autoplay?: boolean;
  narrow?: boolean; // portrait media: cap the width
}
const { src, alt, video, caption, basis, wide = false, light = true, autoplay = true, narrow = false } = Astro.props;
const full = src ? await getImage({ src, width: Math.min(2000, src.width), format: 'webp', quality: 82 }) : undefined;
---

<figure class:list={['reveal my-8', wide && 'lg:-mx-16', narrow && 'mx-auto max-w-sm']}>
  <div class:list={['overflow-hidden rounded-xl border border-line', light && !video ? 'bg-white' : 'bg-sunk']}>
    {
      video ? (
        <button type="button" data-zoom data-hover-host class="block w-full cursor-zoom-in" aria-label={`Enlarge video: ${alt}`}>
          <VideoLoop slug={video.slug} name={video.name} poster={video.poster} alt={alt} autoplay={autoplay} fit="contain" posterWidth={1280} sizes="(min-width: 1024px) 740px, 100vw" />
        </button>
      ) : (
        src && (
          <a href={full!.src} data-zoom class="block cursor-zoom-in" aria-label={`Enlarge image: ${alt}`}>
            <Picture
              src={src}
              alt={alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, Math.min(1600, src.width)].filter((w, i, a) => w <= src.width && a.indexOf(w) === i)}
              sizes="(min-width: 1024px) 820px, 100vw"
              quality={72}
              class="h-auto w-full"
            />
          </a>
        )
      )
    }
  </div>
  {
    (caption || basis) && (
      <figcaption class="mt-2.5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm leading-relaxed text-ink-3">
        {basis && <span class="chip !py-0 !text-[0.65rem] uppercase">{basis}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>
