---
/**
 * Silent looping clip. The poster is a responsive, lazily loaded <Picture> (AVIF/WebP); the <video> sits on top,
 * has preload="none" and no poster, and fades in only once it actually plays. So an unplayed clip costs one small image.
 * Plays on hover for pointer devices, in view for touch / `autoplay`; see src/scripts/site.ts.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  slug: string;
  name: string;
  poster: ImageMetadata;
  alt: string;
  autoplay?: boolean;
  posterWidth?: number;
  sizes?: string;
  class?: string;
  fit?: 'cover' | 'contain';
  eager?: boolean;
  position?: string; // object-position utility, e.g. 'object-left'
}
const { slug, name, poster, alt, autoplay = false, posterWidth = 960, sizes, class: cls, fit = 'cover', eager = false, position = '' } = Astro.props;
const maxW = Math.min(posterWidth, poster.width);
const widths = [360, 640, 960, 1400].filter((w) => w < maxW).concat(maxW);
const base = `/media/${slug}/${name}`;
const objectFit = `${fit === 'cover' ? 'object-cover' : 'object-contain'} ${position}`;
---

<div class:list={[cls ?? 'relative h-full w-full']}>
  <Picture
    src={poster}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes ?? `(min-width: 1024px) ${maxW}px, 100vw`}
    quality={68}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class:list={['block h-full w-full', objectFit]}
  />
  <video
    class:list={['loop-video absolute inset-0 h-full w-full opacity-0 transition-opacity duration-300', objectFit]}
    data-loop
    data-autoplay={autoplay ? '' : undefined}
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={`${base}.webm`} type="video/webm" />
    <source src={`${base}.mp4`} type="video/mp4" />
  </video>
</div>
