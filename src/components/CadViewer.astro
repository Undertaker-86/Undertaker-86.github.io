---
/**
 * Interactive 3D CAD viewer. Ships only a poster + a button; the <model-viewer> web component (~280 KB gz)
 * and the GLB are fetched when the visitor asks for them, so the page budget is untouched.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: string; // GLB under /public
  poster: ImageMetadata;
  alt: string;
  caption?: string;
  sizeLabel?: string;
  orbit?: string; // model-viewer camera-orbit
  hero?: boolean;
}
const { src, poster, alt, caption, sizeLabel, orbit = '35deg 65deg auto', hero = false } = Astro.props;
---

<figure class:list={[hero ? 'my-0' : 'reveal my-8']}>
  <div class:list={['cad-stage relative overflow-hidden border border-line bg-sunk', hero ? 'rounded-2xl' : 'rounded-xl']} data-cad data-src={src} data-alt={alt} data-orbit={orbit}>
    <div class="grid-bg absolute inset-0 opacity-80"></div>
    <Picture src={poster} alt={alt} formats={['avif', 'webp']} widths={[640, 1000, 1400].filter((w) => w <= poster.width)} sizes="(min-width: 1024px) 760px, 100vw" quality={72} class="cad-poster relative block h-full w-full object-contain" />
    <button type="button" data-cad-load class="absolute inset-x-0 bottom-4 mx-auto flex w-max items-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-on-accent shadow-lg transition hover:brightness-110">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="M3 7l9 5 9-5M12 12v10" /></svg>
      Rotate the 3D model{sizeLabel && <span class="font-mono text-xs font-normal opacity-80">({sizeLabel})</span>}
    </button>
    <p class="cad-hint pointer-events-none absolute top-3 left-3 hidden rounded-full bg-black/55 px-2.5 py-1 font-mono text-[0.65rem] text-white/85">
      drag to rotate · scroll / pinch to zoom · right-drag to pan
    </p>
  </div>
  {caption && <figcaption class="mt-2.5 text-sm text-ink-3">{caption}</figcaption>}
</figure>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-cad]').forEach((stage) => {
      const btn = stage.querySelector<HTMLButtonElement>('[data-cad-load]');
      if (!btn || btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Loading 3D model…';
        await import('@google/model-viewer');
        const mv = document.createElement('model-viewer');
        mv.setAttribute('src', stage.dataset.src!);
        mv.setAttribute('alt', stage.dataset.alt!);
        mv.setAttribute('camera-controls', '');
        mv.setAttribute('auto-rotate', '');
        mv.setAttribute('auto-rotate-delay', '1500');
        mv.setAttribute('rotation-per-second', '18deg');
        mv.setAttribute('interaction-prompt', 'none');
        mv.setAttribute('shadow-intensity', '0.8');
        mv.setAttribute('exposure', '1.05');
        mv.setAttribute('tone-mapping', 'neutral');
        mv.setAttribute('camera-orbit', stage.dataset.orbit!);
        mv.setAttribute('min-camera-orbit', 'auto auto 5%');
        mv.className = 'absolute inset-0 h-full w-full';
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) mv.removeAttribute('auto-rotate');
        mv.addEventListener('load', () => {
          stage.querySelector('.cad-poster')?.classList.add('invisible');
          btn.remove();
          stage.querySelector('.cad-hint')?.classList.remove('hidden');
        });
        mv.addEventListener('error', () => {
          btn.disabled = false;
          btn.textContent = 'Could not load the model. Retry';
        });
        stage.append(mv);
      });
    });
  });
</script>

<style>
  .cad-stage {
    aspect-ratio: 16 / 10;
  }
  .cad-stage :global(model-viewer) {
    --poster-color: transparent;
    background: transparent;
  }
</style>
