---
/**
 * Small static SVG line chart (no JS). One y-axis only. Series colour by role: 'accent' (the result)
 * or 'muted' (reference/raw). Legend always shown for ≥ 2 series; native <title> tooltips on markers.
 */
interface Series {
  name: string;
  x: number[];
  y: number[];
  tone?: 'accent' | 'muted';
  markers?: boolean;
}
interface Props {
  series: Series[];
  title: string;
  xLabel: string;
  yLabel: string;
  xDomain?: [number, number];
  yDomain?: [number, number];
  xTicks?: number[];
  yTicks?: number[];
  caption?: string;
  basis?: string;
  height?: number;
  vlines?: { x: number; label?: string }[];
  vband?: [number, number];
}
const { series, title, xLabel, yLabel, caption, basis, height = 300, vlines = [], vband } = Astro.props;
const allX = series.flatMap((s) => s.x);
const allY = series.flatMap((s) => s.y);
const [x0, x1] = Astro.props.xDomain ?? [Math.min(...allX), Math.max(...allX)];
const [y0, y1] = Astro.props.yDomain ?? [Math.min(...allY), Math.max(...allY)];
const W = 720, H = height, L = 64, R = 16, T = 16, B = 52;
const sx = (x: number) => L + ((x - x0) / (x1 - x0)) * (W - L - R);
const sy = (y: number) => T + (1 - (y - y0) / (y1 - y0)) * (H - T - B);
const nice = (a: number, b: number, n = 5) => {
  const step0 = (b - a) / n;
  const mag = 10 ** Math.floor(Math.log10(step0));
  const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= step0)!;
  const out: number[] = [];
  for (let v = Math.ceil(a / step) * step; v <= b + 1e-9; v += step) out.push(+v.toFixed(10));
  return out;
};
const xt = Astro.props.xTicks ?? nice(x0, x1);
const yt = Astro.props.yTicks ?? nice(y0, y1, 4);
const fmt = (v: number) => (Math.abs(v) >= 1000 ? v.toLocaleString('en') : `${+v.toFixed(2)}`);
const path = (s: Series) =>
  s.x.map((x, i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)},${sy(s.y[i]).toFixed(1)}`).join('');
const color = (s: Series) => (s.tone === 'muted' ? 'var(--ink-3)' : 'var(--accent)');
---

<figure class="reveal my-8">
  <div class="card p-4 sm:p-5">
    <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <p class="text-sm font-semibold text-ink">{title}</p>
      {
        series.length > 1 && (
          <ul class="flex flex-wrap gap-4 text-xs text-ink-2" aria-label="Legend">
            {series.map((s) => (
              <li class="flex items-center gap-1.5">
                <span class="inline-block h-0.5 w-4 rounded" style={`background:${color(s)}`} />
                {s.name}
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full overflow-visible" role="img" aria-label={`${title}. ${caption ?? ''}`}>
      {vband && <rect x={sx(vband[0])} y={T} width={sx(vband[1]) - sx(vband[0])} height={H - T - B} fill="var(--accent-soft)" />}
      <g font-family="var(--font-mono)" font-size="17" fill="var(--ink-3)">
        {
          yt.map((v) => (
            <g>
              <line x1={L} x2={W - R} y1={sy(v)} y2={sy(v)} stroke="var(--line)" stroke-width="1" />
              <text x={L - 10} y={sy(v) + 5} text-anchor="end">{fmt(v)}</text>
            </g>
          ))
        }
        {xt.map((v) => <text x={sx(v)} y={H - B + 24} text-anchor="middle">{fmt(v)}</text>)}
        <text x={(L + W - R) / 2} y={H - 6} text-anchor="middle" fill="var(--ink-2)" font-family="var(--font-sans)" font-size="17">{xLabel}</text>
        <text transform={`translate(16 ${(T + H - B) / 2}) rotate(-90)`} text-anchor="middle" fill="var(--ink-2)" font-family="var(--font-sans)" font-size="17">{yLabel}</text>
      </g>
      <line x1={L} x2={W - R} y1={H - B} y2={H - B} stroke="var(--line-strong)" stroke-width="1.5" />
      {
        vlines.map((v) => (
          <g>
            <line x1={sx(v.x)} x2={sx(v.x)} y1={T} y2={H - B} stroke="var(--ink-3)" stroke-dasharray="4 4" stroke-width="1" />
            {v.label && <text x={sx(v.x) + 6} y={T + 14} font-size="15" fill="var(--ink-3)" font-family="var(--font-mono)">{v.label}</text>}
          </g>
        ))
      }
      {
        series.map((s) => (
          <g>
            <path d={path(s)} fill="none" stroke={color(s)} stroke-width={s.tone === 'muted' ? 1.5 : 2} stroke-linejoin="round" stroke-linecap="round" />
            {s.markers &&
              s.x.map((x, i) => (
                <circle cx={sx(x)} cy={sy(s.y[i])} r="5" fill={color(s)} stroke="var(--bg-elev)" stroke-width="2">
                  <title>{`${s.name}: ${xLabel} ${fmt(x)} → ${fmt(s.y[i])}`}</title>
                </circle>
              ))}
          </g>
        ))
      }
    </svg>
  </div>
  {
    (caption || basis) && (
      <figcaption class="mt-2.5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-ink-3">
        {basis && <span class="chip !py-0 !text-[0.65rem] uppercase">{basis}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>
